Screen {
    layout: vertical;
}

MainWindow {
    height: 1fr;
}

#main-tabs {
    height: 1fr;
}

TabPane {
    padding: 1;
}

#sidebar {
    width: 28;
    height: 100%;
    dock: left;
    border-right: solid $primary;
    padding: 1;
}

#content {
    width: 1fr;
    height: 100%;
    padding: 1;
}

.sidebar-title {
    text-style: bold;
    margin-bottom: 1;
}

SidebarButton {
    width: 100%;
    margin: 0 0 1 0;
}

SidebarButton.-active {
    background: $primary 20%;
}

SidebarButton:focus {
    border: heavy $accent;
}

SectionTitle {
    text-style: bold;
    margin: 1 0 1 0;
}

HelpText {
    color: $text-muted;
    margin-bottom: 1;
}

.field-key {
    text-style: bold;
}

.field-help {
    color: $text-muted;
}

FormRow {
    height: auto;
    margin-bottom: 1;
}

Input:focus {
    border: heavy $accent;
}

Button:focus {
    border: heavy $accent;
}

Select:focus {
    border: heavy $accent;
}

RichLog {
    height: 12;
    border: solid $primary;
    margin-top: 1;
}

ViewOutput RichLog {
    border: none;
    margin-top: 0;
    height: 1fr;
    min-height: 6;
}

ViewOutput DataTable {
    min-height: 6;
    height: auto;
}

DataTable {
    height: 1fr;
    min-height: 10;
}

DataTable:focus {
    border: heavy $accent;
}

StatusPanel {
    height: auto;
    border: solid $primary;
    padding: 1;
    margin-bottom: 1;
}

.-high-contrast Screen {
    background: black;
    color: white;
}

.-high-contrast Button:focus {
    border: heavy white;
    background: $primary;
}

.-high-contrast Input:focus {
    border: heavy white;
}
