#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

missing=0

if command -v gitleaks >/dev/null 2>&1; then
  if [ "${GITHUB_USAGE_SKIP_GITLEAKS:-}" != "1" ]; then
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse --verify HEAD >/dev/null 2>&1; then
      gitleaks detect --source . --redact
    else
      gitleaks detect --source . --redact --no-git
    fi
  fi
else
  if [ "${GITHUB_USAGE_SKIP_GITLEAKS:-}" = "1" ]; then
    echo "Skipping gitleaks (GITHUB_USAGE_SKIP_GITLEAKS=1)."
  else
    echo "Missing gitleaks. Install it to run secret scanning locally."
    missing=1
  fi
fi

# All third-party packages live in optional extras ([project].dependencies is
# empty), so audit the full locked set from uv.lock when uv is available. Fall
# back to auditing the installed environment rather than skipping the check.
if ! command -v pip-audit >/dev/null 2>&1; then
  echo "Missing pip-audit. Install dev tools with: python3 -m pip install -e '.[dev]'"
  missing=1
elif command -v uv >/dev/null 2>&1 && [ -f uv.lock ]; then
  locked_reqs="$(mktemp)"
  trap 'rm -f "$locked_reqs"' EXIT
  echo "==> pip-audit (locked dependencies from uv.lock, all extras)"
  uv export --frozen --all-extras --no-emit-project --quiet >"$locked_reqs"
  pip-audit --progress-spinner off --require-hashes --disable-pip -r "$locked_reqs"
else
  echo "==> pip-audit (installed environment; install uv to audit uv.lock instead)"
  pip-audit --progress-spinner off
fi

if command -v bandit >/dev/null 2>&1; then
  bandit -r src
else
  echo "Missing bandit. Install dev tools with: python3 -m pip install -e '.[dev]'"
  missing=1
fi

exit "$missing"
