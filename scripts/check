#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> Python syntax"
scripts/python -m py_compile github-usage src/github_usage/*.py

echo "==> Unit tests"
PYTHONPATH=src scripts/python -m unittest discover -s tests -v

echo "==> CLI smoke"
test -x start.sh
./start.sh --help >/dev/null
./start.sh </dev/null | grep -q "Usage: ./start.sh"
PYTHONPATH=src scripts/python -m github_usage --help >/dev/null
SMOKE_HOME="$(mktemp -d)"
env -u GITHUB_TOKEN GITHUB_USAGE_CLI=1 HOME="$SMOKE_HOME" PYTHONPATH=src scripts/python -m github_usage >/tmp/github-usage-smoke.out 2>&1 && {
  cat /tmp/github-usage-smoke.out
  echo "Expected no-token smoke command to fail"
  exit 1
}
grep -q "No GitHub token found" /tmp/github-usage-smoke.out

echo "==> Size check"
scripts/python scripts/check-sizes

echo "==> Static type check"
scripts/typecheck

echo "==> Backup policy"
scripts/check-backups

echo "==> Coverage"
scripts/coverage-check

echo "==> Complexity and module size"
scripts/check-complexity

echo "check passed"
